# 本地环境变量模板
# 用法示例：set -a; source .env; set +a
# 生产环境必须由部署系统单独注入，不得把生产域名、IP 或密钥写入本文件。

APP_ENV=local
APP_DOMAIN=localhost
APP_PUBLIC_BASE_URL=http://127.0.0.1:8080
APP_SERVER_IP=127.0.0.1
ORDER_SERVICE_URL=http://127.0.0.1:8081

GATEWAY_PORT=8080
ORDER_SERVICE_PORT=8081

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=haode
MYSQL_USERNAME=haode
MYSQL_PASSWORD=change-me

HAODE_ADMIN_USERNAME=admin
HAODE_ADMIN_PASSWORD=change-me
HAODE_ADMIN_TOKEN_SECRET=change-me-to-a-long-random-secret
APP_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://127.0.0.1:8090,http://localhost:8090

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# 微信配置由运行环境注入；本地未启动后端时，小程序只能显示真实请求失败。
WECHAT_APPID=replace-with-wechat-appid
WECHAT_SECRET=replace-with-wechat-secret

WECHAT_PAY_MCHID=replace-with-merchant-id
WECHAT_PAY_SERIAL_NO=replace-with-certificate-serial
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_API_V3_KEY=replace-with-api-v3-key
WECHAT_PAY_NOTIFY_URL=https://your-domain.example/api/payments/wechat/notify
